rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userDoc() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function isAdmin() { return signedIn() && (userDoc().data.role in ['admin', 'super_admin']); }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if signedIn() && request.auth.uid == userId;
      allow update, delete: if isAdmin() || request.auth.uid == userId;
    }

    match /{collection}/{docId} {
      allow read, write: if isAdmin();
    }

    match /fields/{docId} {
      allow read, write: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
    }
    match /crops/{docId} {
      allow read, write: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
    }
    match /activities/{docId} {
      allow read, write: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
    }
    match /expenses/{docId} {
      allow read, write: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
    }
    match /irrigation_logs/{docId} {
      allow read, write: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
    }
    match /notifications/{docId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }
    match /mandi_prices/{docId} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /farming_tips/{docId} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /government_schemes/{docId} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /support_tickets/{docId} {
      allow create: if signedIn();
      allow read: if signedIn() && (isAdmin() || resource.data.ownerId == request.auth.uid);
      allow update: if signedIn() && (isAdmin() || resource.data.ownerId == request.auth.uid);
    }
  }
}
